;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": an operations robot performs staffing
;; scheduling, program-record entry and case-concern escalation support for
;; social welfare managers (ISCO 1344). Its physical work is the program's
;; logistics on distribution days: moving pallets of relief parcels from the
;; store to the distribution hall, and lifting parcels onto the hand-over
;; table where caseworkers meet recipients.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-1344"
 :cases
 [{:id :relief-parcel-shuttle
   :kind :transport
   :procedure "operations robot shuttles a load of food and hygiene relief parcels 70 m from the store to the distribution hall"
   :params {:mass-kg 110.0 :distance-m 70.0 :v-max-mps 1.2 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 300.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.40}
   :sweep {:param :payload-kg :values [50.0 150.0 250.0 350.0 450.0]}
   :quantity :cycle-time-s
   :limit {:max 75.0 :basis "estimate: one restock trip while a caseworker completes about one recipient hand-over"}
   :boundary {:lo 10.0 :hi 1200.0}}
  {:id :parcel-onto-handover-table
   :kind :manipulator
   :procedure "arm lifts a relief parcel from the pallet onto the hand-over table at waist height"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 6.0 :m2-kg 4.5
            :from [0.65 -0.20] :to [0.45 0.50] :duration-s 2.5 :steps 400}
   :sweep {:param :payload-kg :values [3.0 6.0 10.0 14.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 160.0 :basis "estimate: continuous shoulder torque of a ~15 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 50.0}}]}
